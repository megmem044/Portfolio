{
  "name": "toodle-bff",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "npm run check:api-types && tsc --noEmit",
    "generate:api-types": "openapi-typescript ../backend/target/openapi.json -o src/generated/spring-api.ts",
    "check:api-types": "openapi-typescript ../backend/target/openapi.json -o src/generated/spring-api.ts --check",
    "test": "tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "cors": "latest",
    "express": "latest"
  },
  "devDependencies": {
    "@types/cors": "latest",
    "@types/express": "latest",
    "openapi-typescript": "7.13.0",
    "tsx": "latest",
    "typescript": "latest"
  }
}
